/* ── Reset & base ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #ffffff;
  color: #1a1a1a;
  line-height: 1.6;
}

.hidden { display: none !important; }

/* ── Navbar ── */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 40px;
  border-bottom: 1px solid #f0f0f0;
  position: sticky;
  top: 0;
  background: white;
  z-index: 100;
}

.logo {
  font-size: 22px;
  font-weight: 700;
  color: #6C47FF;
  letter-spacing: -0.5px;
}

.nav-buttons { display: flex; gap: 10px; align-items: center; }

.user-name {
  font-size: 14px;
  color: #555;
  margin-right: 4px;
}

/* ── Buttons ── */
.btn-primary {
  background: #6C47FF;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.15s;
}
.btn-primary:hover { background: #5535dd; }

.btn-ghost {
  background: transparent;
  color: #444;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 10px 20px;
  font-size: 14px;
  cursor: pointer;
  transition: border-color 0.15s;
}
.btn-ghost:hover { border-color: #6C47FF; color: #6C47FF; }

.btn-large { padding: 14px 32px; font-size: 16px; border-radius: 10px; }
.btn-full { width: 100%; padding: 13px; font-size: 15px; margin-top: 6px; border-radius: 8px; }

/* ── Hero ── */
.hero {
  text-align: center;
  padding: 80px 24px 60px;
  max-width: 680px;
  margin: 0 auto;
}

.hero-tag {
  display: inline-block;
  background: #EEEDFE;
  color: #6C47FF;
  font-size: 13px;
  font-weight: 500;
  padding: 5px 14px;
  border-radius: 20px;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: 52px;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1.5px;
  color: #111;
  margin-bottom: 16px;
}

.hero-sub {
  font-size: 18px;
  color: #666;
  margin-bottom: 36px;
  line-height: 1.5;
}

/* ── Demo box ── */
.demo-box {
  background: #fafafa;
  border: 1.5px solid #e8e8e8;
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 32px;
  text-align: left;
}

.demo-label {
  font-size: 12px;
  font-weight: 500;
  color: #6C47FF;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
}

.demo-input-row {
  display: flex;
  gap: 10px;
  align-items: center;
}

.demo-input-row input {
  flex: 1;
  padding: 12px 16px;
  border: 1.5px solid #ddd;
  border-radius: 10px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.15s;
}
.demo-input-row input:focus { border-color: #6C47FF; }

.mic-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #6C47FF;
  color: white;
  border: none;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.15s;
}
.mic-btn:hover { background: #5535dd; }

.demo-hint {
  font-size: 12px;
  color: #aaa;
  margin-top: 10px;
}

.demo-result {
  margin-top: 16px;
  background: white;
  border: 1.5px solid #6C47FF;
  border-radius: 12px;
  padding: 16px;
}

.demo-result .result-title {
  font-size: 11px;
  font-weight: 600;
  color: #6C47FF;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
}

.demo-result .result-amount {
  font-size: 22px;
  font-weight: 700;
  color: #111;
  margin-bottom: 4px;
}

.demo-result .result-detail {
  font-size: 13px;
  color: #555;
  margin-bottom: 10px;
}

.split-chips {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.chip {
  background: #EEEDFE;
  color: #3C3489;
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 20px;
  font-weight: 500;
}

.chip.paid { background: #EAF3DE; color: #27500A; }

/* ── Features ── */
.features {
  background: #fafafa;
  padding: 80px 40px;
  text-align: center;
}

.features h2 {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 48px;
  letter-spacing: -0.5px;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 24px;
  max-width: 960px;
  margin: 0 auto;
}

.feature-card {
  background: white;
  border: 1px solid #eee;
  border-radius: 16px;
  padding: 28px 24px;
  text-align: left;
}

.feature-icon { font-size: 28px; margin-bottom: 12px; }

.feature-card h3 {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #111;
}

.feature-card p { font-size: 14px; color: #666; line-height: 1.5; }

/* ── How it works ── */
.how-it-works {
  padding: 80px 40px;
  text-align: center;
  max-width: 860px;
  margin: 0 auto;
}

.how-it-works h2 {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 48px;
  letter-spacing: -0.5px;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.step {
  background: #fafafa;
  border: 1px solid #eee;
  border-radius: 16px;
  padding: 28px 24px;
  max-width: 220px;
  text-align: left;
}

.step-number {
  width: 32px;
  height: 32px;
  background: #6C47FF;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 12px;
}

.step h3 { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
.step p { font-size: 13px; color: #666; }

.step-arrow { font-size: 24px; color: #ccc; }

/* ── Footer ── */
.footer {
  background: #111;
  color: #aaa;
  text-align: center;
  padding: 40px 24px;
}

.footer-logo { font-size: 20px; font-weight: 700; color: #6C47FF; margin-bottom: 8px; }
.footer p { font-size: 14px; margin-bottom: 4px; }
.footer-email { color: #666; font-size: 13px; }

/* ── Auth Modal ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  background: white;
  border-radius: 20px;
  padding: 36px;
  width: 100%;
  max-width: 400px;
  position: relative;
}

.modal h2 { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
.modal-sub { font-size: 14px; color: #888; margin-bottom: 24px; }

.modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: #f5f5f5;
  border: none;
  border-radius: 50%;
  width: 30px;
  height: 30px;
  font-size: 13px;
  cursor: pointer;
  color: #555;
}

.form-group { margin-bottom: 16px; }

.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #444;
  margin-bottom: 6px;
}

.form-group input {
  width: 100%;
  padding: 11px 14px;
  border: 1.5px solid #ddd;
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.15s;
}
.form-group input:focus { border-color: #6C47FF; }

.modal-switch {
  text-align: center;
  font-size: 13px;
  color: #888;
  margin-top: 16px;
}
.modal-switch span { color: #6C47FF; cursor: pointer; font-weight: 500; }

.error-msg {
  background: #FCEBEB;
  color: #A32D2D;
  font-size: 13px;
  padding: 10px 14px;
  border-radius: 8px;
  margin-bottom: 12px;
}

/* ── Dashboard placeholder ── */
.dashboard-placeholder {
  max-width: 480px;
  margin: 80px auto;
  text-align: center;
  padding: 0 24px;
}

.placeholder-icon { font-size: 48px; margin-bottom: 16px; }
.dashboard-placeholder h2 { font-size: 28px; font-weight: 700; margin-bottom: 10px; }
.dashboard-placeholder p { font-size: 16px; color: #555; margin-bottom: 8px; }
.placeholder-sub { font-size: 14px; color: #999; margin-bottom: 32px; }

.coming-soon-list {
  background: #fafafa;
  border: 1px solid #eee;
  border-radius: 16px;
  padding: 24px;
  text-align: left;
}

.coming-item {
  padding: 10px 0;
  font-size: 14px;
  color: #999;
  border-bottom: 1px solid #f0f0f0;
}
.coming-item:last-child { border-bottom: none; }
.coming-item.done { color: #3B6D11; font-weight: 500; }

/* ── Mobile ── */
@media (max-width: 600px) {
  .hero h1 { font-size: 36px; }
  .navbar { padding: 14px 20px; }
  .features, .how-it-works { padding: 50px 20px; }
  .step-arrow { display: none; }
  .steps { flex-direction: column; align-items: stretch; }
  .step { max-width: 100%; }
}
